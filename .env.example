# Copy to .env (git-ignored). Docker compose reads it from this folder; run.bat reads the real environment.

# Admin password: unlocks /admin/, where you create a token per project; callers send theirs as X-Internal-Token.
# Empty = no auth at all (local use only).
MOONSHINE_ADMIN_PASSWORD=

# Port the service listens on (compose: the port published by the load balancer).
MOONSHINE_PORT=9240

# Compose only: API copies behind nginx. Each copy holds the model in RAM (about 0.5 GB for base).
MOONSHINE_REPLICAS=1
# MOONSHINE_MEM_LIMIT=1g

# CPU threads (onnxruntime decides when unset). Use the number of physical cores. A value saved on the /admin/ page beats this one.
# MOONSHINE_NUM_THREAD=4

# Tunables (update check hours, in-flight cap, answers kept, longest audio, base model, number format,
# load at start) are set on the /admin/ Settings card and saved in settings.json. These variables are only a starting
# value for run.bat; compose does not pass them. A saved value wins.
# MOONSHINE_UPDATE_CHECK_HOURS=6
# MOONSHINE_MAX_INFLIGHT=
# MOONSHINE_CACHE_SIZE=256
# MOONSHINE_MAX_SECONDS=150
# MOONSHINE_MODEL=base
# MOONSHINE_COMPUTE_TYPE=float
# MOONSHINE_WARM=1

# run.bat only (compose sets these itself): bind address.
# MOONSHINE_HOST=127.0.0.1
# Where tokens are stored (hashed) and the admin page folder. Docker sets /data/tokens.json and /app/web.
# MOONSHINE_TOKENS_FILE=tokens.json
# MOONSHINE_WEB_DIR=web
